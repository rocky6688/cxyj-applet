@import "../../styles/theme.wxss";

.home-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* 品牌区 */
.brand-area {
  text-align: center;
  margin-bottom: 48rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.brand-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background: var(--brand-grad);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.35);
}

.brand-name {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--brand);
}

.brand-slogan {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 14rpx;
  letter-spacing: 4rpx;
}

/* 主卡片 */
.hero-card {
  position: relative;
  width: 100%;
  max-width: 700rpx;
  box-sizing: border-box;
  padding: 56rpx 40rpx 44rpx;
  text-align: center;
}

.hero-glow {
  position: absolute;
  left: 50%;
  top: -120rpx;
  width: 460rpx;
  height: 280rpx;
  margin-left: -230rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.16) 0%, rgba(255, 107, 53, 0) 70%);
  pointer-events: none;
}

.hero-title {
  position: relative;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text-1);
}

.hero-sub {
  position: relative;
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 14rpx;
}

.hero-actions {
  position: relative;
  display: flex;
  gap: 20rpx;
  margin-top: 44rpx;
}

.hero-btn {
  flex: 1;
}

/* 后台入口 */
.admin-entry {
  margin-top: 44rpx;
  padding: 16rpx 36rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-3);
}
