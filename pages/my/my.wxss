@import "../../styles/theme.wxss";

.my-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* 顶部品牌区域 */
.my-header {
  padding: 24rpx 0 36rpx;
  text-align: center;
}

.brand {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--brand);
}

.slogan {
  color: var(--text-2);
  font-size: 26rpx;
  margin-top: 12rpx;
}

/* 未登录卡片 */
.card {
  padding: 44rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  align-self: flex-start;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 28rpx;
}

.avatar-wrap {
  margin-bottom: 36rpx;
}

.avatar-btn {
  padding: 0;
  border: none;
  background: transparent;
  line-height: 0;
}

.avatar-main {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--surface-sunken);
  border: 3rpx solid rgba(255, 107, 53, 0.22);
}

.login-btn {
  width: 100%;
  text-align: center;
}

.privacy-tip {
  color: var(--text-3);
  font-size: 23rpx;
  text-align: center;
  margin-top: 22rpx;
}

/* 已登录资料卡 */
.profile-card {
  padding: 32rpx 28rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--surface-sunken);
  border: 3rpx solid rgba(255, 107, 53, 0.22);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.16);
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-1);
}

.profile-role-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  margin-left: auto;
  text-align: right;
}

.profile-sub {
  font-size: 23rpx;
  color: var(--text-2);
}

/* 菜单分组 */
.menu-list {
  margin-top: 28rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-title {
  font-size: 30rpx;
  color: var(--text-1);
}

.menu-title.danger {
  color: var(--danger);
}
