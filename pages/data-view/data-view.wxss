@import "../../styles/theme.wxss";

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text-1);
  margin-bottom: 24rpx;
}

/* ===== 工具条（横向滚动的胶囊） ===== */
.toolbar {
  margin-bottom: 24rpx;
}

.toolbar-scroll {
  width: 100%;
  white-space: nowrap;
}

.toolbar-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 0;
}

.toolbar-row picker {
  flex: none;
}

.chip-today {
  background: var(--brand-soft);
  border-color: rgba(255, 107, 53, 0.35);
  color: var(--brand-deep);
  font-weight: 600;
}

.export-btn {
  flex: none;
}

/* ===== 指标卡 ===== */
.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.metric {
  padding: 24rpx 12rpx;
  text-align: center;
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-2);
}

.metric-value {
  font-size: 44rpx;
  margin-top: 8rpx;
}

/* ===== 图表 ===== */
.chart-card {
  margin-top: 24rpx;
  padding: 20rpx;
}

.chart {
  width: 100%;
  height: 300rpx;
}

.chart-placeholder {
  width: 100%;
  height: 300rpx;
}

/* ===== 图表空状态（纯 CSS 图标） ===== */
.chart-empty {
  padding: 44rpx 0 48rpx;
}

.chart-empty-icon {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 20rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
}

.chart-empty-bar {
  position: absolute;
  bottom: 34rpx;
  width: 16rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: rgba(255, 107, 53, 0.35);
}

.chart-empty-bar.bar-a { left: 24rpx; height: 30rpx; }
.chart-empty-bar.bar-b { left: 50rpx; height: 52rpx; }
.chart-empty-bar.bar-c { left: 76rpx; height: 40rpx; }
.chart-empty-bar.bar-d { left: 100rpx; height: 66rpx; }

.chart-empty-axis {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 26rpx;
  height: 0;
  border-top: 2rpx dashed rgba(255, 107, 53, 0.45);
}

/* ===== 业务员统计 ===== */
.card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}

.staff-grid {
  display: flex;
  flex-direction: column;
}

.staff-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
  gap: 12rpx;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid var(--hairline);
  font-size: 26rpx;
  color: var(--text-1);
}

.staff-row:last-child {
  border-bottom: none;
}

.staff-header {
  padding: 14rpx 8rpx;
  border-bottom: none;
  border-radius: var(--r-control);
  background: var(--surface-sunken);
  color: var(--text-2);
  font-size: 24rpx;
}

.c1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.c2 {
  text-align: center;
}

.staff-header .c2 {
  color: var(--text-2);
  font-weight: 500;
}

/* ===== 日期选择抽屉 ===== */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(20, 20, 24, 0.35);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  -webkit-backdrop-filter: blur(6rpx);
  backdrop-filter: blur(6rpx);
}

.sheet-card {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--surface-solid);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(31, 45, 61, 0.16);
  animation: sheet-up 0.24s ease-out both;
}

@keyframes sheet-up {
  from { transform: translateY(60rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(60, 60, 67, 0.2);
  margin: 8rpx auto 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.sheet-sub {
  font-size: 23rpx;
  color: var(--text-3);
  margin: 8rpx 0 16rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.sheet-actions .btn-brand,
.sheet-actions .btn-ghost {
  flex: 1;
  text-align: center;
}

/* ===== 日历 ===== */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface-sunken);
  color: var(--text-2);
  font-size: 34rpx;
}

.cal-nav-year {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  font-size: 28rpx;
}

.cal-nav-off {
  opacity: 0.3;
}

.cal-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.cal-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.cal-week-item {
  text-align: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  color: var(--text-3);
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 8rpx;
}

.cal-cell {
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.cal-cell-today {
  color: var(--brand);
  font-weight: 600;
}

.cal-cell-selected {
  background: var(--brand-grad);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}

.cal-cell-disabled {
  color: rgba(60, 60, 67, 0.25);
}
