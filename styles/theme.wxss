/**
 * 局部设计令牌与公共组件 —— 仅服务于首页（pages/index）与我的（pages/my）
 * 用法：在页面 wxss 顶部 @import "../../styles/theme.wxss";
 * 说明：主色固定 #ff6b35，其余只用中性灰阶；图标全部由 CSS 绘制，无图片资源
 */

/* ==================== 设计令牌 ==================== */
page {
  --brand: #ff6b35;
  --brand-deep: #e8551f;
  --brand-soft: #fff1e9;
  --brand-grad: linear-gradient(135deg, #ff8a5a 0%, #ff6b35 100%);

  --bg: #f2f2f7;
  --surface: rgba(255, 255, 255, 0.86);
  --surface-solid: #ffffff;
  --surface-sunken: rgba(118, 118, 128, 0.08);
  --hairline: rgba(60, 60, 67, 0.12);

  --text-1: #1c1c1e;
  --text-2: #6e6e73;
  --text-3: #a1a1a6;
  --danger: #ff3b30;

  --r-card: 24rpx;
  --r-pill: 999rpx;

  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 12rpx 32rpx rgba(31, 45, 61, 0.06);
  --shadow-brand: 0 8rpx 24rpx rgba(255, 107, 53, 0.22);
}

/* ==================== 页面外壳 ==================== */

/* 统一底色 + 两处极淡品牌光斑，作为科技感的来源 */
.tech-bg {
  background-color: var(--bg);
  background-image:
    radial-gradient(120% 70% at 100% 0%, rgba(255, 107, 53, 0.10) 0%, rgba(255, 107, 53, 0) 55%),
    radial-gradient(110% 60% at 0% 100%, rgba(120, 140, 180, 0.10) 0%, rgba(120, 140, 180, 0) 60%);
}

/* ==================== 玻璃卡片 ==================== */
.glass-card {
  position: relative;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}

/* ==================== 分组列表（iOS 分组） ==================== */
.group-list {
  background: var(--surface-solid);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.group-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.group-row + .group-row::before {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--hairline);
  transform: scaleY(0.5);
}

/* ==================== 按钮 ==================== */
button {
  margin: 0 !important;
}

button::after {
  border: none;
}

.btn-brand,
.btn-ghost {
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  padding: 22rpx 36rpx;
  border: none;
}

.btn-brand {
  background: var(--brand-grad);
  color: #fff;
  box-shadow: var(--shadow-brand);
}

.btn-ghost {
  background: var(--surface-solid);
  color: var(--brand-deep);
  border: 1rpx solid rgba(255, 107, 53, 0.35);
  box-shadow: none;
}

/* 小号文字按钮（工具栏/列表内操作） */
.btn-mini {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--surface-solid);
  color: var(--brand-deep);
  border: 1rpx solid rgba(255, 107, 53, 0.3);
}

/* ==================== 胶囊筛选 ==================== */
.chip {
  flex: none;
  padding: 14rpx 26rpx;
  border-radius: var(--r-pill);
  background: var(--surface-solid);
  border: 1rpx solid var(--hairline);
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.2;
}

.chip-active {
  background: var(--brand-soft);
  border-color: rgba(255, 107, 53, 0.35);
  color: var(--brand-deep);
  font-weight: 600;
}

/* ==================== 状态标签 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  line-height: 1.3;
}

.tag-brand {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

/* ==================== 数字 ==================== */
.stat-num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  font-weight: 700;
  color: var(--brand);
}

/* ==================== 空状态 ==================== */
.empty-state {
  padding: 72rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.empty-state .empty-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: var(--r-card);
  background: var(--surface-sunken);
  position: relative;
}

.empty-state .empty-mark::before {
  content: '';
  position: absolute;
  left: 30rpx;
  top: 34rpx;
  width: 36rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--text-3);
  box-shadow: 0 20rpx 0 0 var(--text-3);
}

/* ==================== 纯 CSS 图标 ==================== */
.icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--brand-soft);
  position: relative;
}

.icon::before,
.icon::after {
  content: '';
  position: absolute;
}

.icon-user::before {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  left: 24rpx;
  top: 14rpx;
}

.icon-user::after {
  width: 30rpx;
  height: 16rpx;
  border-radius: 15rpx 15rpx 8rpx 8rpx;
  background: var(--brand);
  left: 17rpx;
  bottom: 12rpx;
}

.icon-store::before {
  width: 34rpx;
  height: 14rpx;
  border-radius: 7rpx 7rpx 3rpx 3rpx;
  background: var(--brand);
  left: 15rpx;
  top: 12rpx;
}

.icon-store::after {
  width: 28rpx;
  height: 22rpx;
  border-radius: 4rpx 4rpx 8rpx 8rpx;
  background: rgba(255, 107, 53, 0.45);
  left: 18rpx;
  bottom: 12rpx;
}

.icon-template::before {
  width: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand);
  left: 18rpx;
  top: 17rpx;
  box-shadow: 0 12rpx 0 0 var(--brand), 0 24rpx 0 0 rgba(255, 107, 53, 0.45);
}

.icon-chart::before {
  width: 8rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: rgba(255, 107, 53, 0.45);
  left: 16rpx;
  bottom: 14rpx;
  box-shadow: 12rpx -8rpx 0 0 var(--brand), 24rpx -16rpx 0 0 rgba(255, 107, 53, 0.45);
}

.icon-plus::before {
  width: 26rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--brand);
  left: 19rpx;
  top: 30rpx;
}

.icon-plus::after {
  width: 5rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: var(--brand);
  left: 30rpx;
  top: 19rpx;
}

/* 灰色图标变体（用于退出登录等中性项） */
.icon-mute {
  background: var(--surface-sunken);
  filter: grayscale(1);
  opacity: 0.55;
}

/* 通用右向 chevron */
.chevron {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  border-right: 3rpx solid var(--text-3);
  border-bottom: 3rpx solid var(--text-3);
  transform: rotate(-45deg);
}

/* ==================== 交互反馈 ==================== */
.press {
  transform: scale(0.98);
  opacity: 0.92;
  transition: transform 0.18s ease, opacity 0.18s ease;
}
